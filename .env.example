# Bắt buộc — lấy từ @BotFather trên Telegram
TELEGRAM_BOT_TOKEN=your_token_here

# Tuỳ chọn — provider ACP: "gemini" (mặc định), "claude" hoặc "codex".
# - gemini: dùng Gemini CLI (cần `gemini` đã cài và login).
# - claude: dùng Claude Code CLI qua adapter @zed-industries/claude-code-acp (cần `claude` đã login).
# - codex:  dùng Codex CLI qua adapter @zed-industries/codex-acp (cần `codex login` sẵn, hoặc CODEX_API_KEY).
PROVIDER=gemini

# Tuỳ chọn — model mặc định khi khởi động, dùng chung cho mọi provider.
# Để trống = mỗi provider tự dùng model mặc định của nó.
# Ví dụ tên model theo provider (không cần phần effort, Codex dùng mặc định):
#   gemini: gemini-3-flash-preview | gemini-3-pro-preview | auto-gemini-3
#   claude: default (Opus) | sonnet | haiku
#   codex:  gpt-5.5 | gpt-5.4 | gpt-5.4-mini | gpt-5.3-codex
# Lưu ý: Claude/Codex KHÔNG báo lỗi nếu tên model sai — sẽ âm thầm dùng default.
PROVIDER_MODEL=

# Tuỳ chọn — tên hiển thị của bot trong tin nhắn
BOT_NAME=ONEBOT 🤖

# Tuỳ chọn — chế độ trả lời trong group: "mention" (chỉ khi @tag hoặc reply, mặc định) hoặc "always"
GROUP_REPLY_MODE=mention

# Tuỳ chọn — emoji dùng để react tin nhắn của user khi đang xử lý (mặc định: 🤔)
REACTION_EMOJI=🤔

# Tuỳ chọn — Web UI port (mặc định: 8686)
WEB_UI_PORT=8686

# Tuỳ chọn — Web UI host. Mặc định 127.0.0.1 (chỉ localhost).
# Đổi sang 0.0.0.0 nếu muốn expose ra mạng — nhớ đặt WEB_UI_PASSWORD bên dưới.
WEB_UI_HOST=127.0.0.1

# Tuỳ chọn — Mật khẩu bảo vệ Web UI. Để TRỐNG = không yêu cầu đăng nhập (chỉ nên dùng localhost).
# Khi expose ra mạng (WEB_UI_HOST=0.0.0.0), BẮT BUỘC đặt mật khẩu. Đăng nhập được nhớ 30 ngày qua cookie.
WEB_UI_PASSWORD=

# Tuỳ chọn — Số message tối đa giữ lại trong web-history.json (mặc định: 500)
WEB_HISTORY_LIMIT=500

# Tuỳ chọn — Số dòng tối đa giữ lại trong SESSION.md (lịch sử tin nhắn user, inject vào prompt khởi động).
# Đặt 0 hoặc bỏ trống để TẮT hoàn toàn (không ghi, không đọc SESSION.md). Mặc định: 0 (tắt).
SESSION_HISTORY_LIMIT=0

# Tuỳ chọn — Số lần retry khi Gemini gặp lỗi transient (no capacity, 503, rate limit...). Mặc định 3.
GEMINI_RETRY_MAX=3

# Tuỳ chọn — Delay giữa các lần retry (ms), CSV. Mặc định 2s, 5s, 10s.
GEMINI_RETRY_DELAYS=2000,5000,10000
